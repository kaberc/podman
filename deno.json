{
  "name": "@kaberc/podman",
  "description": "Typed Podman client for Deno, Node.js and Bun. Full libpod API with zero dependencies.",
  "version": "0.6.0",
  "exports": "./mod.ts",
  "exclude": [
    "npm/",
    "_node/",
    "scripts/",
    ".podman-source/",
    ".omo/",
    ".opencode/"
  ],
  "publish": {
    "exclude": [
      ".omo/",
      ".opencode/",
      ".codegraph",
      ".podman-source/",
      "scripts/",
      "_node/",
      "_build_tmp/",
      "npm/",
      "tests/",
      ".github/"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/yaml": "jsr:@std/yaml@1.3.0",
    "@deno/dnt": "jsr:@deno/dnt@0.44.0"
  },
  "tasks": {
    "check": "deno check mod.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env --allow-net",
    "generate-types": "deno run --allow-net --allow-write --allow-read --allow-run scripts/generate-types.ts",
    "build-npm": "deno run -A scripts/build_npm.ts",
    "test-node": "node scripts/test_node.mjs"
  },
  "lint": {
    "rules": {
      "exclude": ["require-await"]
    }
  },
  "compilerOptions": {
    "strict": true
  }
}
